# Langfuse 自托管实例地址（浏览器打开的同一个地址）
LANGFUSE_HOST=http://localhost:3000
# Project 的 API Keys（Settings -> API Keys 生成）
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# 上报内容模式：structural（默认，保结构弃内容）| full（原文，仅内网调试用）
ATIF2LF_MODE=structural
# Trial 过滤：all | success | failure
ATIF2LF_FILTER=all
# 可选：把本次 Run 关联到 Langfuse 的某个 Dataset
ATIF2LF_DATASET_ID=
# 可选：Experiment 展示名，默认用 run 根目录名
ATIF2LF_RUN_NAME=
