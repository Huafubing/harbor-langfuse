# ===== LiteLLM Proxy =====
LITELLM_MASTER_KEY=sk-master-change-me

# ===== 内网 vllm-ascend 服务 =====
# 宿主机上的 vllm：http://host.docker.internal:8000/v1
# 其他内网机器：http://<ip>:<port>/v1
VLLM_ASCEND_BASE_URL=http://host.docker.internal:8000/v1
VLLM_ASCEND_API_KEY=dummy
# litellm_config.yaml 里 model 的实际模型名需与 vllm serve 一致（当前写死 Qwen2.5-72B-Instruct）

# ===== Langfuse（部署完成后回填）=====
# 容器内可达地址（同 compose 网络内的服务名）
LANGFUSE_INTERNAL_URL=http://langfuse-web:3000
# 宿主机访问地址（工具脚本用）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
# base64(pk:sk)：printf 'pk-lf-xxx:sk-lf-xxx' | base64 -w0
LANGFUSE_AUTH_B64=

# ===== 分析工具通用 =====
# Harbor run 产物根目录（含若干 trial 子目录）
RUN_ROOT=/root/harbor-langfuse/examples/demo-run
